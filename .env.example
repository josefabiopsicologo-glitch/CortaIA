# Transcrição / legendas automáticas por IA.
# O CortaIA usa a API de transcrição compatível com OpenAI Whisper.
# Se estas variáveis não forem definidas, a rota /api/transcribe retorna 501
# e a UI cai para um modo de legenda manual/demonstração.

OPENAI_API_KEY=
# Opcional: base URL de um provedor compatível (padrão: https://api.openai.com/v1)
OPENAI_BASE_URL=https://api.openai.com/v1
# Modelo de transcrição (padrão: whisper-1)
TRANSCRIBE_MODEL=whisper-1
